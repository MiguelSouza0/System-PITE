APP_NAME=System-PITE
APP_ENV=local
APP_KEY=base64:SystemPITEHackatonTurismoMunicipal2026Key=
APP_DEBUG=true
APP_TIMEZONE=America/Recife
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=system_pite
DB_USERNAME=postgres
DB_PASSWORD=postgres

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

OPENAI_API_KEY=your_openai_api_key_here
LEAFLET_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MUNICIPALITY_NAME="Município Exemplo"
MUNICIPALITY_STATE="PB"
